ENV=development
DATABASE_URL=postgresql+psycopg://moduyaksok:moduyaksok@localhost:5433/moduyaksok
JWT_SECRET_KEY=dev-secret-change-me
GOOGLE_CLIENT_ID=
# Google redirect 로그인 완료 후 돌아갈 프런트 주소. 비우면 ENV에 따라 로컬 또는
# https://moduyaksok.vercel.app을 사용한다.
FRONTEND_URL=http://localhost:5173

# DeepEval 파이프라인 성능평가 테스트 전용 (tests/eval/), 사용자 BYOK 키와 무관.
# 셋 다 선택사항 — upstage -> openai -> anthropic 순으로 유효한 첫 키를 씀.
DEEPEVAL_UPSTAGE_API_KEY=
DEEPEVAL_OPENAI_API_KEY=
DEEPEVAL_ANTHROPIC_API_KEY=

# Step2 place_candidates 조회용 (NAVER API HUB > NAVER 검색 > 지역, 지도 API와 별개).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Step4 enrich_routes용 (lab.odsay.com 가입 후 애플리케이션 등록해서 발급, 서비스
# 플랫폼은 URI 방식으로 등록). ODSAY_REFERER_URL은 등록한 서비스 URI와 정확히
# 일치해야 함(프로토콜 제외) — 로컬은 localhost:8000, Render 배포본은
# moduyaksok.onrender.com처럼 환경마다 다르게 설정.
ODSAY_API_KEY=
ODSAY_REFERER_URL=localhost:8000
# ODsay Basic 무료 등급 공식 한도(일 1,000건). 기본값이 이미 그 한도라 보통 안 건드려도 됨.
ODSAY_DAILY_CALL_LIMIT=1000

# Step4 자차 옵션용 (NCP Maps 콘솔 > Application 등록, Directions 5 API 선택해서
# 발급). 서버 REST 호출은 Secret까지 헤더로 보내는 게 인증이라 도메인 제한이
# 없음 — dev/prod 값이 같아도 됨.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# 네이버 지역검색 호출량 제어(app/services/rate_limiter.py) — 태그 검색·광역
# 지역 확장으로 호출이 크게 늘어서 추가. 기본값이 네이버 API HUB 공식 한도
# (초당 10건, 일일 25,000건)라 보통 안 건드려도 됨.
NAVER_RATE_LIMIT_PER_SECOND=10
NAVER_DAILY_CALL_LIMIT=25000

# 일일 호출 카운터 저장소(../moduyaksok-db/docker-compose.yml의 redis 서비스).
# 로컬 Homebrew Redis와 포트 충돌 피하려고 6380 사용(postgres가 5433 쓰는 것과 같은 이유).
REDIS_URL=redis://localhost:6380/0
SCHEDULE_GENERATOR_MODE=hybrid
