ENV=development
DATABASE_URL=postgresql+psycopg://moduyaksok:moduyaksok@localhost:5433/moduyaksok
JWT_SECRET_KEY=dev-secret-change-me
GOOGLE_CLIENT_ID=
CREDENTIAL_ENCRYPTION_KEY=

# DeepEval 파이프라인 성능평가 테스트 전용 (tests/eval/), 사용자 BYOK 키와 무관.
# 셋 다 선택사항 — upstage -> openai -> anthropic 순으로 유효한 첫 키를 씀.
DEEPEVAL_UPSTAGE_API_KEY=
DEEPEVAL_OPENAI_API_KEY=
DEEPEVAL_ANTHROPIC_API_KEY=

# Step2 place_candidates 조회용 (NAVER API HUB > NAVER 검색 > 지역, 지도 API와 별개).
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# Step4 enrich_routes용 (lab.odsay.com 가입 후 애플리케이션 등록해서 발급, 서비스
# 플랫폼은 URI 방식으로 등록). ODSAY_REFERER_URL은 등록한 서비스 URI와 정확히
# 일치해야 함(프로토콜 제외) — 로컬은 localhost:8000, Render 배포본은
# moduyaksok.onrender.com처럼 환경마다 다르게 설정.
ODSAY_API_KEY=
ODSAY_REFERER_URL=localhost:8000
