# Vite 모드별 env 파일(.env.development/.env.production)을 씀 — 로컬 개발은
# npm run dev(mode=development), 배포 빌드는 mode=production으로 자동 로드됨.
# 둘 다 민감정보 없어서(공개 클라이언트 ID·공개 API 베이스 URL) 커밋되어 있음.
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=
# NCP Maps Dynamic Map SDK용 Client ID(Secret 아님, 공개 값) — DoodleMap이 이 값으로
# Naver Maps JS SDK를 로드한다(src/composables/useNaverMapScript.ts).
VITE_NAVER_MAP_CLIENT_ID=
